<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MarkdownEditor2022.UnitTests</RootNamespace>
    <AssemblyName>MarkdownEditor2022.UnitTests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" />

    <!--
      MarkdownEditor2022.csproj excludes the Visual Studio runtime assemblies because the IDE supplies them.
      Tests run outside the IDE, so the toolkit is referenced here with its runtime assets.
    -->
    <PackageReference Include="Community.VisualStudio.Toolkit.17" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MarkdownEditor2022.csproj" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\preview-content-script.test.cjs" Link="preview-content-script.test.cjs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\Margin\preview-content.js;..\..\src\Margin\prism.js;..\..\src\Margin\mermaid.min.js;..\..\src\Margin\mathjax.js;..\..\src\Margin\color.js"
             Link="Margin\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>