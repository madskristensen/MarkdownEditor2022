  <Commands package="MarkdownEditor2022">
    <Menus>
      <Menu guid="MarkdownEditor2022" id="MarkdownMenu" priority="9000" type="Menu">
        <Parent guid="VSMainMenu" id="CodeWindow.TextEditGroup"/>
        <Strings>
          <ButtonText>Markdown</ButtonText>
          <LocCanonicalName>.Markdown.ContextMenu</LocCanonicalName>
        </Strings>
