      <Menu guid="MarkdownEditor2022" id="MarkdownDocumentToolbar" priority="100" type="Toolbar">
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings>
          <ButtonText>Markdown Document</ButtonText>
          <CommandName>Markdown Document</CommandName>
        </Strings>
      </Menu>
      <Menu guid="MarkdownEditor2022" id="HeadingMenu" priority="100" type="MenuControllerLatched">
        <Parent guid="MarkdownEditor2022" id="ToolbarFormattingGroup"/>
        <CommandFlag>TextOnly</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <CommandFlag>TextIsAnchorCommand</CommandFlag>
        <CommandFlag>DontCache</CommandFlag>
        <Strings>
          <ButtonText>Paragraph</ButtonText>
          <CommandName>Heading level</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
